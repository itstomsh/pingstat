# CTE with the longest normal pause between runs, as gap(secs). The usual interval
# comes from the newest runs, not from the runs in a report's period, so the same
# event looks the same in every period and a long pause in a short period cannot
# become the norm.
usual_gap() {
    cat <<'EOF'
sample AS (
    SELECT timestamp FROM ping_data
    WHERE status IS NOT 'error'
    ORDER BY timestamp DESC LIMIT 1000
),
intervals AS (
    SELECT (julianday(timestamp) - julianday(LAG(timestamp) OVER (ORDER BY timestamp))) * 86400 AS secs
    FROM sample
),
-- 3 times the (lower) median interval, which is at least a minute with cron
gap(secs) AS (
    SELECT 3 * MAX(60, COALESCE((SELECT secs FROM intervals
                                 WHERE secs IS NOT NULL
                                 ORDER BY secs LIMIT 1
                                 OFFSET (SELECT (COUNT(secs) - 1) / 2 FROM intervals)), 60))
)
EOF
}

# One line per server: its newest run, or 'no data'. stale means that no run came
# when one was due: cron or the machine has stopped.
do_show_status() {
    if [ -n "$SINGLE_SERVER" ]; then
        if ! check_server_exist "$SINGLE_SERVER"; then return 1; fi
        SRV_ARR=("$SINGLE_SERVER")
    else
        IFS=' ' read -ra SRV_ARR <<< "$SERVERS"
        if [ ${#SRV_ARR[@]} -eq 0 ]; then
            echo "No servers in config."
            echo "Add with 'pingstat add <server>'"
            return 1
        fi
    fi

    local srv dbfile row last_run state since loss
    printf '%-30s  %-19s  %-7s  %-19s  %s\n' server last_run state down_since loss
    for srv in "${SRV_ARR[@]}"; do
        dbfile="$(get_db_path "$srv")"
        init_db "$dbfile"
        row=$(run_sql "$dbfile" <<EOF
WITH $(failure_streak),
newest AS (
    SELECT * FROM ping_data ORDER BY timestamp DESC, id DESC LIMIT 1
),
judged AS (
    SELECT *, CASE
        WHEN (julianday('now') - julianday(timestamp)) * 86400 > (SELECT secs FROM gap) THEN 'stale'
        WHEN status IS 'error' THEN 'error'
        WHEN status IS 'dns_error' THEN 'dns'
        WHEN status IS 'net_error' THEN 'network'
        WHEN loss >= 100 THEN 'down'
        ELSE 'up' END AS state
    FROM newest
)
SELECT datetime(timestamp, 'localtime'), state,
       CASE WHEN state IN ('down', 'dns', 'network') THEN datetime((SELECT at FROM streak), 'localtime') ELSE '-' END,
       CASE WHEN loss IS NULL THEN '-' ELSE printf('%.0f%%', loss) END
FROM judged;
EOF
)
        if [ -z "$row" ]; then
            printf '%-30s  %-19s  %-7s  %-19s  %s\n' "$srv" - "no data" - -
        else
            IFS='|' read -r last_run state since loss <<< "$row"
            printf '%-30s  %-19s  %-7s  %-19s  %s\n' "$srv" "$last_run" "$state" "$since" "$loss"
        fi
    done
}

# CTEs for the failure a server is in now: gap as in usual_gap, failing(timestamp)
# with the runs since the last reply and streak(at) with the first of them after
# the last monitoring gap
failure_streak() {
    usual_gap
    cat <<'EOF'
,
last_reply(at) AS (
    SELECT COALESCE((SELECT timestamp FROM ping_data WHERE loss < 100
                     ORDER BY timestamp DESC LIMIT 1), '')
),
failing AS (
    SELECT timestamp,
           (julianday(timestamp) - julianday(LAG(timestamp) OVER (ORDER BY timestamp, id))) * 86400 AS since_prev
    FROM ping_data
    WHERE status IS NOT 'error' AND timestamp > (SELECT at FROM last_reply)
),
streak(at) AS (
    SELECT MAX(timestamp) FROM failing
    WHERE since_prev IS NULL OR since_prev > (SELECT secs FROM gap)
)
EOF
}

# An outage is a series of consecutive runs without a reply: 100% loss, or a DNS
# or network error. It started at or before its first failed run and ended by the
# next run that got a reply. Runs with status 'error' measured nothing and are
# treated as if they never ran. A pause of more than 3 typical intervals between
# runs is a monitoring gap: what happened during it is unknown, so it ends an outage.
do_show_outages() {
    local srv="$1"
    local days="$2"
    local dbfile
    dbfile="$(get_db_path "$srv")"
    init_db "$dbfile"

    echo "----- Outages for '$srv' (last $days days) -----"
    echo ""
    local result
    result=$(run_sql -header -column "$dbfile" <<EOF
WITH cutoff(at) AS (
    SELECT datetime('now', '-$days days')
),
-- Start at the last reply before the window: an outage that began before the
-- window then keeps its real start
runs AS (
    SELECT id, timestamp, status, COALESCE(loss, 100) >= 100 AS down
    FROM ping_data
    WHERE status IS NOT 'error'
      AND timestamp >= COALESCE((SELECT timestamp FROM ping_data
                                 WHERE timestamp < (SELECT at FROM cutoff) AND loss < 100
                                 ORDER BY timestamp DESC LIMIT 1), '')
),
steps AS (
    SELECT *,
           LAG(down) OVER w AS prev_down,
           LEAD(timestamp) OVER w AS next_run,
           (julianday(timestamp) - julianday(LAG(timestamp) OVER w)) * 86400 AS secs_since_prev
    FROM runs
    WINDOW w AS (ORDER BY timestamp, id)
),
$(usual_gap),
grouped AS (
    SELECT *, SUM(down AND (prev_down IS NOT 1 OR secs_since_prev > (SELECT secs FROM gap)))
              OVER (ORDER BY timestamp, id) AS grp
    FROM steps
),
outages AS (
    SELECT MIN(timestamp) AS first_down, MAX(timestamp) AS last_down, COUNT(*) AS failed_runs,
           SUM(status IS 'dns_error') AS dns_runs, SUM(status IS 'net_error') AS net_runs,
           -- The run after the last failed one; NULL if that is the newest run
           CASE WHEN COUNT(next_run) < COUNT(*) THEN NULL ELSE MAX(next_run) END AS next_run
    FROM grouped
    WHERE down
    GROUP BY grp
),
checked AS (
    SELECT *, (julianday(COALESCE(next_run, 'now')) - julianday(last_down)) * 86400
              > (SELECT secs FROM gap) AS gap_after
    FROM outages
),
timed AS (
    SELECT *, CASE WHEN gap_after THEN last_down ELSE COALESCE(next_run, datetime('now')) END AS end_at
    FROM checked
)
SELECT
    datetime(first_down, 'localtime') AS started,
    CASE WHEN gap_after THEN 'monitoring gap'
         WHEN next_run IS NULL THEN 'ongoing'
         ELSE datetime(next_run, 'localtime') END AS back_up,
    printf('%dh %02dm', CAST(round((julianday(end_at) - julianday(first_down)) * 86400) AS INTEGER) / 3600,
                        CAST(round((julianday(end_at) - julianday(first_down)) * 86400) AS INTEGER) % 3600 / 60) AS duration,
    failed_runs,
    CASE WHEN dns_runs = failed_runs THEN 'dns'
         WHEN net_runs = failed_runs THEN 'network'
         WHEN dns_runs + net_runs = 0 THEN 'no reply'
         ELSE 'mixed' END AS cause
FROM timed
WHERE end_at >= (SELECT at FROM cutoff)
ORDER BY first_down DESC;
EOF
)
    if [ -z "$result" ]; then
        echo "No outages."
    else
        echo "$result"
    fi
    echo "---------------------------------------------------------------------------"
    echo ""
    echo "Note: An outage started at or before 'started' and ended by 'back_up'."
    echo "'monitoring gap': no runs after the last failed one, so the real end is unknown"
    echo "and the duration stops at that run."
}

###############################################################################
# 8) Utility: check if a server is in the list
###############################################################################
server_in_list() {
    local srv="$1"
    IFS=' ' read -ra SRV_ARR <<< "$SERVERS"
    for s in ${SRV_ARR[@]+"${SRV_ARR[@]}"}; do
        [ "$s" = "$srv" ] && return 0
    done
    return 1
}

###############################################################################
# 9) Main Execution
###############################################################################
read_config
SINGLE_SERVER=""
QUIET=false

# If no arguments, show usage
[ $# -eq 0 ] && usage && exit 0

reject_argument() {
    echo "Unknown argument '$1'. See 'pingstat --help'."
    exit 1
}

# Commands that take a fixed number of arguments; the others are checked below
case "$1" in
    --version|--update|--force-update|--uninstall|-h|--help|list)
        [ $# -le 1 ] || reject_argument "$2"
        ;;
    add|remove)
        [ $# -le 2 ] || reject_argument "$3"
        ;;
esac

# Handle primary arguments
case "$1" in
    --version)
        check_version
        exit 0
        ;;
    --update)
        FORCE=false
        update_pingstat
        ;;
    --force-update)
        FORCE=true
        update_pingstat
        ;;
    --uninstall)
        uninstall_pingstat
        ;;
    -h|--help)
        usage
        exit 0
        ;;
    add)
        [ -z "${2:-}" ] && { echo "Usage: pingstat add <server>"; exit 1; }
        add_server "$2"
        exit 0
        ;;
    remove)
        if [ -z "${2:-}" ]; then
            echo "Usage: pingstat remove <server>"
            exit 1
        fi
        remove_server "$2"
        exit 0
        ;;
    list)
        list_servers
        exit 0
        ;;
    -p)
        ACTION="ping"
        shift
        ;;
    status)
        ACTION="status"
        shift
        ;;
    -d)
        ACTION="daily"
        if [[ "${2:-}" =~ ^[0-9]+$ ]]; then
            DAILY_LIMIT="$2"
            shift 2
        else
            DAILY_LIMIT="20"
            shift
        fi
        ;;
    -m)
        ACTION="monthly"
        if [[ "${2:-}" =~ ^[0-9]+$ ]]; then
            MONTHLY_LIMIT="$2"
            shift 2
        else
            MONTHLY_LIMIT="12"
            shift
        fi
        ;;
    -o)
        ACTION="outages"
        if [[ "${2:-}" =~ ^[0-9]+$ ]]; then
            OUTAGE_DAYS="$2"
            shift 2
        else
            OUTAGE_DAYS="30"
            shift
        fi
        ;;
    -H)
        ACTION="hourly"
        if [[ "${2:-}" =~ ^[0-9]+$ ]]; then
            HOURLY_DAYS="$2"
            shift 2
        else
            HOURLY_DAYS="7"
            shift
        fi
        ;;
    *)
        # Unknown option or no further action
        usage
        exit 1
        ;;
esac

# Parse optional -s <server>
while [ $# -gt 0 ]; do
    case "$1" in
        -s)
            [ -z "${2:-}" ] && { echo "Usage: -s <server>"; exit 1; }
            SINGLE_SERVER="$2"
            shift 2
            ;;
        -q)
            [ "$ACTION" = "ping" ] || reject_argument "$1"
            QUIET=true
            shift
            ;;
        *)
            reject_argument "$1"
            ;;
    esac
done

# Execute the selected ACTION
case "$ACTION" in
    "ping")
        do_ping_all
        ;;
    "status")
        do_show_status
        ;;
    "daily")
        show_stats daily "$DAILY_LIMIT"
        ;;
    "monthly")
        show_stats monthly "$MONTHLY_LIMIT"
        ;;
    "hourly")
        show_stats hourly "$HOURLY_DAYS"
        ;;
    "outages")
        show_stats outages "$OUTAGE_DAYS"
        ;;
    *)
        usage
        ;;
esac
