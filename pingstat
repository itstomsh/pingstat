#!/usr/bin/env bash
set -euo pipefail

# If running as root, warn and exit
if [[ $EUID -eq 0 ]]; then
  echo "ERROR: This script is not intended to be run as root (sudo)."
  echo "Please run as a normal user."
  exit 1
fi

###############################################################################
# 1) Configuration Paths & Global Variables
###############################################################################
VERSION="1.4.0"
SCRIPT_PATH=$(realpath "$0" 2>/dev/null || command -v pingstat)

# XDG-based config & data paths
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/pingstat"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/pingstat"
CONFIG_FILE="$CONFIG_DIR/servers.list"
# Before 1.4.0: a Bash file with SERVERS="a b c", migrated by read_config
OLD_CONFIG_FILE="$CONFIG_DIR/servers.conf"

# Ensure directories exist
mkdir -p "$CONFIG_DIR" "$DATA_DIR"

###############################################################################
# 2) Version Checking & Update
###############################################################################
get_latest_version() {
    local url="https://raw.githubusercontent.com/itstomsh/pingstat/main/pingstat"
    local version_line

    if command -v curl >/dev/null 2>&1; then
        version_line=$(curl -fsL --max-time 10 "$url" | grep -E '^VERSION=' || true)
    else
        version_line=$(wget -qO- -T 10 "$url" | grep -E '^VERSION=' || true)
    fi

    if [[ -z "$version_line" ]]; then
        echo ""
        return 1
    fi

    echo "$version_line" | cut -d= -f2 | tr -d '"'
}

# Latest version from remote, fetched only by --version and --update
LATEST_VERSION=""

check_version() {
    echo "Current version: $VERSION"
    LATEST_VERSION=$(get_latest_version || true)

    if [ -z "$LATEST_VERSION" ]; then
        echo "WARNING: Unable to determine the latest available version."
        echo "Check your internet connection or the remote script structure."
        return
    fi

    if [ "$(printf '%s\n' "$LATEST_VERSION" "$VERSION" | sort -V | head -n1)" != "$LATEST_VERSION" ]; then
        echo "New version available: $LATEST_VERSION"
        echo "Run: 'pingstat --update' to update."
    else
        echo "You are running the latest version!"
    fi
}

update_pingstat() {
    LATEST_VERSION=$(get_latest_version || true)
    if [ -z "$LATEST_VERSION" ] && [ "$FORCE" != true ]; then
        echo "ERROR: Unable to determine the latest avaible version."
        echo "Check your internet connection or the remote script content."
        exit 1
    fi
    
    if [ "$(printf '%s\n' "$LATEST_VERSION" "$VERSION" | sort -V | head -n1)" != "$LATEST_VERSION" ] || [ "$FORCE" = true ]; then
        echo "Updating to version $LATEST_VERSION..."

        # Detect installation type (system-wide or local)
        if [ -w "$SCRIPT_PATH" ]; then
            USE_SUDO=""
        else
            USE_SUDO="sudo"
        fi

        echo "Updating binary at: $SCRIPT_PATH"

        TMPFILE=$(mktemp)
        if command -v curl >/dev/null 2>&1; then
            curl -sL "https://raw.githubusercontent.com/itstomsh/pingstat/main/pingstat" -o "$TMPFILE"
        else
            wget -qO "$TMPFILE" "https://raw.githubusercontent.com/itstomsh/pingstat/main/pingstat"
        fi
        
        if grep -q '^VERSION=' "$TMPFILE"; then
            $USE_SUDO cp "$TMPFILE" "$SCRIPT_PATH"
            $USE_SUDO chmod +x "$SCRIPT_PATH"
            echo "Update complete! Running version: $LATEST_VERSION"
        else
            echo "ERROR: Downloaded file does not appear to be a valid pingstat script."
        fi
        
        rm -f "$TMPFILE"
        exit 0
    else
        echo "You are already running the latest version!"
        exit 0
    fi
}

###############################################################################
# 3) Uninstall Function
###############################################################################
uninstall_pingstat() {
    local answer
    echo "This removes $SCRIPT_PATH and all your pingstat config and data:"
    echo "  $CONFIG_DIR"
    echo "  $DATA_DIR"
    read -r -p "Continue? [y/N] " answer || answer=""
    case "$answer" in
        [Yy]*) ;;
        *)
            echo "Uninstall cancelled."
            exit 1
            ;;
    esac

    echo "Uninstalling pingstat..."

    # Determine if sudo is needed (only for system-wide installs)
    if [ -w "$SCRIPT_PATH" ]; then
        USE_SUDO=""
    else
        USE_SUDO="sudo"
    fi

    # Remove binary
    [ -f "$SCRIPT_PATH" ] && $USE_SUDO rm -f "$SCRIPT_PATH" && echo "Removed $SCRIPT_PATH"

    # Remove config & data directories
    [ -d "$CONFIG_DIR" ] && rm -rf "$CONFIG_DIR" && echo "Removed $CONFIG_DIR"
    [ -d "$DATA_DIR" ] && rm -rf "$DATA_DIR" && echo "Removed $DATA_DIR"

    echo "Uninstallation complete."
    exit 0
}

###############################################################################
# 4) Usage (Help) Function
###############################################################################
usage() {
    cat <<EOF
Usage: pingstat [command] [options]

Server Management:
  add <server>         Add a server to the config list.
  remove <server>      Remove a server from the config list.
  list                 List all servers in the config.

Ping & Stats:
  -p                   Ping all servers (or one with -s).
  -d [N]               Show daily stats for last N days (default 20).
  -m [N]               Show monthly stats for last N months (default 12).
  -H [N]               Show stats per hour of day over last N days (default 7).
  -o [N]               List outages (runs with 100% loss) in last N days (default 30).
  -s <server>          Specify a single server for -p, -d, -m, -H, or -o.

Other Options:
  --version            Show current version.
  --update             Update pingstat if a new version is available.
  --force-update       Always updates no matter what
  --uninstall          Uninstall pingstat entirely.
  -h, --help           Show this help message.
EOF
}

###############################################################################
# 5) Config Handling
###############################################################################
# Server names become ping arguments and file names: no leading '-', no '/'
valid_server_name() {
    [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._:-]*$ ]]
}

# One server per line; blank lines and lines starting with '#' are ignored
read_config() {
    SERVERS=""
    if [ ! -f "$CONFIG_FILE" ] && [ -f "$OLD_CONFIG_FILE" ]; then
        migrate_old_config
    fi
    [ -f "$CONFIG_FILE" ] || return 0

    local line rest
    while read -r line rest || [ -n "$line" ]; do
        line="${line%%#*}"
        [ -z "$line" ] && continue
        if ! valid_server_name "$line"; then
            echo "WARNING: Ignoring invalid server name '$line' in $CONFIG_FILE"
            continue
        fi
        SERVERS="${SERVERS:+$SERVERS }$line"
    done < "$CONFIG_FILE"
}

write_config() {
    local s
    IFS=' ' read -ra SRV_ARR <<< "$SERVERS"
    {
        echo "# pingstat servers, one per line"
        for s in "${SRV_ARR[@]}"; do
            echo "$s"
        done
    } > "$CONFIG_FILE"
}

# Convert servers.conf (SERVERS="a b c") to servers.list without running it
migrate_old_config() {
    local value s
    value=$(sed -nE 's/^[[:space:]]*SERVERS=["'"'"']?([^"'"'"']*)["'"'"']?[[:space:]]*$/\1/p' "$OLD_CONFIG_FILE" | tail -n 1)
    IFS=' ' read -ra SRV_ARR <<< "$value"
    {
        echo "# pingstat servers, one per line"
        for s in "${SRV_ARR[@]}"; do
            echo "$s"
        done
    } > "$CONFIG_FILE"
    mv "$OLD_CONFIG_FILE" "$OLD_CONFIG_FILE.bak"
    echo "Migrated $OLD_CONFIG_FILE to $CONFIG_FILE (old file kept as servers.conf.bak)."
}

###############################################################################
# 6) Server Management Functions
###############################################################################
get_db_path() {
    echo "$DATA_DIR/$1.db"
}

add_server() {
    local srv="$1"
    local response
    local new_srv

    if ! valid_server_name "$srv"; then
        echo "Invalid server name '$srv'. Use a host name or IP address."
        return 1
    fi

    # Check if the server is already in the config
    IFS=' ' read -ra SRV_ARR <<< "$SERVERS"
    for s in "${SRV_ARR[@]}"; do
        if [ "$s" = "$srv" ]; then
            echo "Server '$srv' is already in the config."
            return 0
        fi
    done

    # Ping test: use a single ping request with a short timeout.
    if ! ping -c 1 -W 3 "$srv" &>/dev/null; then
        echo "Ping to '$srv' failed."
        while true; do
            echo "Options: [A]dd it anyway, [N]ew address, or [C]ancel"
            read -r -p "Your choice (a,n,c): " response
            case "$response" in
                [Aa]* )
                    echo "Adding '$srv' despite ping failure."
                    break
                    ;;
                [Nn]* )
                    read -r -p "Enter a new server address: " new_srv
                    if ! valid_server_name "$new_srv"; then
                        echo "Invalid server name '$new_srv'. Use a host name or IP address."
                        continue
                    fi
                    # Replace current srv with the new one and retest
                    srv="$new_srv"
                    if ping -c 1 -W 3 "$srv" &>/dev/null; then
                        echo "Ping to '$srv' succeeded."
                        break
                    else
                        echo "Ping to '$srv' still failed. Try again or choose another option."
                    fi
                    ;;
                [Cc]* )
                    echo "Addition cancelled."
                    return 1
                    ;;
                * )
                    echo "Please answer A, N, or C."
                    ;;
            esac
        done
    fi

    # If we reach here, add the (possibly updated) server.
    IFS=' ' read -ra SRV_ARR <<< "$SERVERS"
    SRV_ARR+=("$srv")
    SERVERS="${SRV_ARR[*]}"
    write_config
    echo "Added server '$srv'."
    return 0
}

remove_server() {
    local srv="$1"
    IFS=' ' read -ra SRV_ARR <<< "$SERVERS"
    local NEW_ARR=()
    local found=0
    for s in "${SRV_ARR[@]}"; do
        if [ "$s" = "$srv" ]; then
            found=1
            continue
        fi
        NEW_ARR+=("$s")
    done

    if [ "$found" -eq 1 ]; then
        SERVERS="${NEW_ARR[*]}"
        write_config
        echo "Removed server '$srv'."
    else
        echo "Server '$srv' not found."
    fi
}

list_servers() {
    IFS=' ' read -ra SRV_ARR <<< "$SERVERS"
    if [ ${#SRV_ARR[@]} -eq 0 ]; then
        echo "No servers in config."
        echo "Add with 'pingstat add <server>'"
        return 1
    fi
    echo "Configured servers:"
    for s in "${SRV_ARR[@]}"; do
        echo "  $s => $(get_db_path "$s")"
    done
}

###############################################################################
# 7) Ping & Stats Functions
###############################################################################
check_server_exist() {
    local server="$1"

    if server_in_list "$server"; then
        return 0  # Server is known, all good
    fi

    echo "Server '$server' is not in your config."
    while true; do
        read -r -p "Would you like to add it now? [Y/n] " choice
        case "$choice" in
            [Yy]*|"")
                if add_server "$server"; then
                    return 0  # Added successfully
                else
                    echo "Addition failed or cancelled. Skipping."
                    return 1
                fi
                ;;
            [Nn]*)
                echo "Skipping."
                return 1
                ;;
            *)
                echo "Please answer yes or no."
                ;;
        esac
    done
}

init_db() {
    local dbfile="$1"
    sqlite3 "$dbfile" <<EOF
CREATE TABLE IF NOT EXISTS ping_data (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    timestamp DATETIME DEFAULT CURRENT_TIMESTAMP,
    min REAL,
    avg REAL,
    max REAL,
    mdev REAL,
    loss REAL
);
EOF
}

do_ping_one() {
    local srv="$1"
    local dbfile
    dbfile="$(get_db_path "$srv")"

    # Skip this server if the previous run (e.g. from cron) is still pinging it
    if command -v flock >/dev/null 2>&1; then
        exec 9>"$DATA_DIR/$srv.lock"
        if ! flock -n 9; then
            echo "Skipped $srv -> previous ping still running"
            return 0
        fi
    fi

    init_db "$dbfile"

    # ping exits non-zero on total loss; that is a result to record, not an error
    local PING_OUTPUT
    PING_OUTPUT=$(ping -c 4 "$srv" 2>&1 || true)

    # iputils:     "4 packets transmitted, 3 received, 25% packet loss"
    # BusyBox/BSD: "4 packets transmitted, 3 packets received, 25% packet loss"
    local PACKETS_TX PACKETS_RX
    PACKETS_TX=$(echo "$PING_OUTPUT" | sed -nE 's/^([0-9]+) packets transmitted.*/\1/p')
    PACKETS_RX=$(echo "$PING_OUTPUT" | sed -nE 's/.* ([0-9]+) (packets )?received.*/\1/p')

    local LOSS MIN="NULL" AVG="NULL" MAX="NULL" MDEV="NULL"
    if [ -z "$PACKETS_TX" ] || [ -z "$PACKETS_RX" ] || [ "$PACKETS_TX" -eq 0 ]; then
        LOSS=100
    else
        LOSS=$(awk "BEGIN {print (1 - $PACKETS_RX/$PACKETS_TX) * 100}")

        # iputils: "rtt min/avg/max/mdev = 10.1/12.5/15.0/1.2 ms"
        # BusyBox: "round-trip min/avg/max = 10.1/12.5/15.0 ms" (no mdev)
        # BSD:     "round-trip min/avg/max/stddev = 10.1/12.5/15.0/1.2 ms"
        local RTT_VALUES
        RTT_VALUES=$(echo "$PING_OUTPUT" | sed -nE 's#^(rtt|round-trip) min/avg/max[^=]*= ([0-9./]+) ms.*#\2#p')
        if [ -n "$RTT_VALUES" ]; then
            IFS='/' read -r MIN AVG MAX MDEV <<< "$RTT_VALUES"
            MDEV="${MDEV:-NULL}"
        fi
    fi

    sqlite3 "$dbfile" <<EOF
INSERT INTO ping_data(min, avg, max, mdev, loss)
VALUES ($MIN, $AVG, $MAX, $MDEV, $LOSS);
EOF

    echo "Pinged $srv -> min=$MIN avg=$AVG max=$MAX mdev=$MDEV loss=${LOSS}% -> $dbfile"
}

do_ping_all() {
    if [ -n "$SINGLE_SERVER" ]; then
        if ! check_server_exist "$SINGLE_SERVER"; then
            return 1
        fi
        SRV_ARR=("$SINGLE_SERVER")
    else
        IFS=' ' read -ra SRV_ARR <<< "$SERVERS"
        if [ ${#SRV_ARR[@]} -eq 0 ]; then
            echo "No servers in config."
            echo "Add with 'pingstat add <server>'"
            return 1
        fi
    fi

    # Ping all servers in parallel, then print the results in config order
    local tmpdir i
    tmpdir=$(mktemp -d)
    for i in "${!SRV_ARR[@]}"; do
        do_ping_one "${SRV_ARR[$i]}" > "$tmpdir/$i" 2>&1 &
    done
    wait
    for i in "${!SRV_ARR[@]}"; do
        cat "$tmpdir/$i"
    done
    rm -rf "$tmpdir"
}

# Run do_show_<kind> for the -s server or for all configured servers
show_stats() {
    local kind="$1"
    local limit="$2"

    if [ -n "$SINGLE_SERVER" ]; then
        if ! check_server_exist "$SINGLE_SERVER"; then return 1; fi
        "do_show_$kind" "$SINGLE_SERVER" "$limit"
    else
        IFS=' ' read -ra SRV_ARR <<< "$SERVERS"
        [ ${#SRV_ARR[@]} -eq 0 ] && echo "No servers in config." && echo "Add with 'pingstat add <server>'" && return 1
        for s in "${SRV_ARR[@]}"; do
            "do_show_$kind" "$s" "$limit"
            echo
        done
    fi
}

# Columns shared by all stats views; '-' when no ping in the group got a reply
stat_columns() {
    cat <<'EOF'
    CASE WHEN MIN(min) IS NULL THEN '-' ELSE printf('%.3f', MIN(min)) END AS abs_min,
    CASE WHEN AVG(min) IS NULL THEN '-' ELSE printf('%.3f', AVG(min)) END AS avg_min,
    CASE WHEN AVG(avg) IS NULL THEN '-' ELSE printf('%.3f', AVG(avg)) END AS avg_avg,
    CASE WHEN AVG(max) IS NULL THEN '-' ELSE printf('%.3f', AVG(max)) END AS avg_max,
    CASE WHEN MAX(max) IS NULL THEN '-' ELSE printf('%.3f', MAX(max)) END AS abs_max,
    CASE WHEN AVG(mdev) IS NULL THEN '-' ELSE printf('%.3f', AVG(mdev)) END AS avg_jitter,
    printf('%.1f%%', AVG(loss)) AS avg_loss
EOF
}

# Timestamps are stored in UTC; all views group by local time
do_show_daily() {
    local srv="$1"
    local limit="$2"
    local dbfile
    dbfile="$(get_db_path "$srv")"
    init_db "$dbfile"

    echo "----- Daily stats for '$srv' (last $limit days) -----"
    echo ""
    sqlite3 -header -column "$dbfile" <<EOF
SELECT
    date(timestamp, 'localtime') AS day,
$(stat_columns),
    CASE strftime('%w', timestamp, 'localtime')
        WHEN '0' THEN 'Sunday'
        WHEN '1' THEN 'Monday'
        WHEN '2' THEN 'Tuesday'
        WHEN '3' THEN 'Wednesday'
        WHEN '4' THEN 'Thursday'
        WHEN '5' THEN 'Friday'
        WHEN '6' THEN 'Saturday'
    END AS weekday,
    COUNT(*) AS num_pings
FROM ping_data
GROUP BY day
ORDER BY day DESC
LIMIT $limit;
EOF
    echo "---------------------------------------------------------------------------------------------------"
    echo ""
    echo "Note: Times are in milliseconds (ms), and packet loss in %."
}

do_show_monthly() {
    local srv="$1"
    local limit="$2"
    local dbfile
    dbfile="$(get_db_path "$srv")"
    init_db "$dbfile"

    echo "----- Monthly stats for '$srv' (last $limit months) -----"
    echo ""
    sqlite3 -header -column "$dbfile" <<EOF
SELECT
    strftime('%Y-%m', timestamp, 'localtime') AS month,
$(stat_columns),
    COUNT(*) AS num_pings
FROM ping_data
GROUP BY month
ORDER BY month DESC
LIMIT $limit;
EOF
    echo "-------------------------------------------------------------------------------------"
    echo ""
    echo "Note: Times are in milliseconds (ms), and packet loss in %."
}

do_show_hourly() {
    local srv="$1"
    local days="$2"
    local dbfile
    dbfile="$(get_db_path "$srv")"
    init_db "$dbfile"

    echo "----- Hourly profile for '$srv' (last $days days) -----"
    echo ""
    sqlite3 -header -column "$dbfile" <<EOF
SELECT
    strftime('%H:00', timestamp, 'localtime') AS hour,
$(stat_columns),
    COUNT(*) AS num_pings
FROM ping_data
WHERE timestamp >= datetime('now', '-$days days')
GROUP BY hour
ORDER BY hour;
EOF
    echo "-----------------------------------------------------------------------------------"
    echo ""
    echo "Note: Times are in milliseconds (ms), and packet loss in %."
}

# An outage is a series of consecutive runs with 100% loss. It started at or
# before its first failed run and ended by the next run that got a reply.
do_show_outages() {
    local srv="$1"
    local days="$2"
    local dbfile
    dbfile="$(get_db_path "$srv")"
    init_db "$dbfile"

    echo "----- Outages for '$srv' (last $days days) -----"
    echo ""
    local result
    result=$(sqlite3 -header -column "$dbfile" <<EOF
WITH runs AS (
    SELECT timestamp, loss >= 100 AS down,
           ROW_NUMBER() OVER (ORDER BY timestamp, id)
         - ROW_NUMBER() OVER (PARTITION BY loss >= 100 ORDER BY timestamp, id) AS grp
    FROM ping_data
    WHERE timestamp >= datetime('now', '-$days days')
),
outages AS (
    SELECT MIN(timestamp) AS first_down, MAX(timestamp) AS last_down, COUNT(*) AS failed_runs
    FROM runs
    WHERE down
    GROUP BY grp
),
ended AS (
    SELECT o.*,
           (SELECT MIN(p.timestamp) FROM ping_data p
            WHERE p.timestamp > o.last_down AND p.loss < 100) AS back_up
    FROM outages o
),
timed AS (
    SELECT *, CAST(round((julianday(COALESCE(back_up, 'now')) - julianday(first_down)) * 86400) AS INTEGER) AS secs
    FROM ended
)
SELECT
    datetime(first_down, 'localtime') AS started,
    COALESCE(datetime(back_up, 'localtime'), 'ongoing') AS back_up,
    printf('%dh %02dm', secs / 3600, secs % 3600 / 60) AS duration,
    failed_runs
FROM timed
ORDER BY first_down DESC;
EOF
)
    if [ -z "$result" ]; then
        echo "No outages."
    else
        echo "$result"
    fi
    echo "--------------------------------------------------------------"
    echo ""
    echo "Note: An outage started at or before 'started' and ended by 'back_up'."
}

###############################################################################
# 8) Utility: check if a server is in the list
###############################################################################
server_in_list() {
    local srv="$1"
    IFS=' ' read -ra SRV_ARR <<< "$SERVERS"
    for s in "${SRV_ARR[@]}"; do
        [ "$s" = "$srv" ] && return 0
    done
    return 1
}

###############################################################################
# 9) Main Execution
###############################################################################
read_config
SINGLE_SERVER=""

# If no arguments, show usage
[ $# -eq 0 ] && usage && exit 0

# Handle primary arguments
case "$1" in
    --version)
        check_version
        exit 0
        ;;
    --update)
        FORCE=false
        update_pingstat
        ;;
    --force-update)
        FORCE=true
        update_pingstat
        ;;
    --uninstall)
        uninstall_pingstat
        ;;
    -h|--help)
        usage
        exit 0
        ;;
    add)
        [ -z "${2:-}" ] && { echo "Usage: pingstat add <server>"; exit 1; }
        add_server "$2"
        exit 0
        ;;
    remove)
        if [ -z "${2:-}" ]; then
            echo "Usage: pingstat remove <server>"
            exit 1
        fi
        remove_server "$2"
        exit 0
        ;;
    list)
        list_servers
        exit 0
        ;;
    -p)
        ACTION="ping"
        shift
        ;;
    -d)
        ACTION="daily"
        if [[ "${2:-}" =~ ^[0-9]+$ ]]; then
            DAILY_LIMIT="$2"
            shift 2
        else
            DAILY_LIMIT="20"
            shift
        fi
        ;;
    -m)
        ACTION="monthly"
        if [[ "${2:-}" =~ ^[0-9]+$ ]]; then
            MONTHLY_LIMIT="$2"
            shift 2
        else
            MONTHLY_LIMIT="12"
            shift
        fi
        ;;
    -o)
        ACTION="outages"
        if [[ "${2:-}" =~ ^[0-9]+$ ]]; then
            OUTAGE_DAYS="$2"
            shift 2
        else
            OUTAGE_DAYS="30"
            shift
        fi
        ;;
    -H)
        ACTION="hourly"
        if [[ "${2:-}" =~ ^[0-9]+$ ]]; then
            HOURLY_DAYS="$2"
            shift 2
        else
            HOURLY_DAYS="7"
            shift
        fi
        ;;
    *)
        # Unknown option or no further action
        usage
        exit 1
        ;;
esac

# Parse optional -s <server>
while [ $# -gt 0 ]; do
    case "$1" in
        -s)
            [ -z "${2:-}" ] && { echo "Usage: -s <server>"; exit 1; }
            SINGLE_SERVER="$2"
            shift 2
            ;;
        *)
            # Any leftover unknown argument
            shift
            ;;
    esac
done

# Execute the selected ACTION
case "$ACTION" in
    "ping")
        do_ping_all
        ;;
    "daily")
        show_stats daily "$DAILY_LIMIT"
        ;;
    "monthly")
        show_stats monthly "$MONTHLY_LIMIT"
        ;;
    "hourly")
        show_stats hourly "$HOURLY_DAYS"
        ;;
    "outages")
        show_stats outages "$OUTAGE_DAYS"
        ;;
    *)
        usage
        ;;
esac
