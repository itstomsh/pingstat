#!/usr/bin/env bash
# Fake ping for the tests: the output format depends on the host name.
host="${*: -1}"
[ -n "${PING_STUB_SLEEP:-}" ] && sleep "$PING_STUB_SLEEP"

case "$host" in
    down.*)
        echo "PING $host (10.0.0.1) 56(84) bytes of data."
        echo ""
        echo "--- $host ping statistics ---"
        echo "4 packets transmitted, 0 received, 100% packet loss, time 3050ms"
        exit 1
        ;;
    nodns.*)
        echo "ping: $host: Name or service not known" >&2
        exit 2
        ;;
    *.busybox)
        echo "--- $host ping statistics ---"
        echo "4 packets transmitted, 4 packets received, 0% packet loss"
        echo "round-trip min/avg/max = 20.1/22.5/25.0 ms"
        ;;
    *.bsd)
        echo "--- $host ping statistics ---"
        echo "4 packets transmitted, 2 packets received, 50.0% packet loss"
        echo "round-trip min/avg/max/stddev = 30.1/32.5/35.0/2.4 ms"
        ;;
    *)
        echo "--- $host ping statistics ---"
        echo "4 packets transmitted, 3 received, 25% packet loss, time 3003ms"
        echo "rtt min/avg/max/mdev = 10.1/12.5/15.0/1.2 ms"
        ;;
esac
